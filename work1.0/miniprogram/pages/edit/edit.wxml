<view class="page"><view class="card form"><view class="field"><text class="field-label">物品名称 *</text><input class="input" placeholder="例如：RG 海牛高达" value="{{itemName}}" data-key="itemName" bindinput="input"/></view><view class="field"><text class="field-label">金额（元）*</text><input class="input money-input" type="digit" placeholder="0.00" value="{{amount}}" data-key="amount" bindinput="input"/></view><view class="field"><text class="field-label">付款日期</text><picker mode="date" value="{{purchaseDate}}" bindchange="date"><view>{{purchaseDate}} ›</view></picker></view><view class="field"><text class="field-label">付款类型</text><picker range="{{paymentTypes}}" value="{{paymentIndex}}" bindchange="payment"><view>{{paymentTypes[paymentIndex]}} ›</view></picker></view><view class="field"><text class="field-label">物品类型</text><picker range="{{itemTypes}}" value="{{typeIndex}}" bindchange="type"><view>{{itemTypes[typeIndex]}} ›</view></picker></view><view class="field" wx:if="{{itemTypes[typeIndex] === '高达'}}"><text class="field-label">高达类别</text><picker range="{{gundamGrades}}" value="{{gradeIndex}}" bindchange="grade"><view>{{gundamGrades[gradeIndex]}} ›</view></picker></view><view class="field"><text class="field-label">商家（选填）</text><input class="input" placeholder="购买渠道或店铺" value="{{merchant}}" data-key="merchant" bindinput="input"/></view><view class="field note"><text class="field-label">备注（选填）</text><textarea placeholder="补款时间、订单信息等" value="{{note}}" data-key="note" bindinput="input"/></view></view><button class="btn save" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存记录</button><button wx:if="{{id}}" class="delete" bindtap="remove">删除这条记录</button></view>
