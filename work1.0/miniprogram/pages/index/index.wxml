<view class="page"><view class="hero"><text class="hero-sub">{{monthText}}消费</text><view class="money"><text class="symbol">¥</text>{{total}}</view><view class="hero-foot"><text>共 {{count}} 笔记录</text><text bindtap="goStats">查看统计 →</text></view></view><view class="section-title row"><text>最近记录</text><text class="more" bindtap="goRecords">查看全部</text></view><view class="card list-card" wx:if="{{recent.length}}"><view class="record row" wx:for="{{recent}}" wx:key="_id"><view><view class="record-name">{{item.itemName}}</view><view class="muted meta">{{item.purchaseDate}} · {{item.paymentText}} · {{item.itemType}}</view></view><text class="record-amount">- ¥{{item.amount}}</text></view></view><view class="card empty" wx:else>还没有消费记录，点击下方按钮开始记账</view><button class="btn add" bindtap="add">＋ 记一笔</button></view><view class="tabs"><view class="tab active"><text class="tab-icon">⌂</text>首页</view><view class="tab" bindtap="goRecords"><text class="tab-icon">≡</text>记录</view><view class="tab" bindtap="goStats"><text class="tab-icon">⌁</text>统计</view><view class="tab" bindtap="goMine"><text class="tab-icon">○</text>我的</view></view>
