<view class="page"><view class="card filters"><view class="row"><picker mode="date" value="{{startDate}}" bindchange="setStart"><view class="date">{{startDate||'开始日期'}}</view></picker><text class="muted">至</text><picker mode="date" value="{{endDate}}" bindchange="setEnd"><view class="date">{{endDate||'结束日期'}}</view></picker></view><view class="sum">区间合计：<text>¥{{total}}</text></view></view><view class="card list" wx:if="{{rows.length}}"><view class="record row" wx:for="{{rows}}" wx:key="_id" data-id="{{item._id}}" bindtap="edit"><view><view class="name">{{item.itemName}}</view><view class="muted meta">{{item.purchaseDate}} · {{item.paymentText}} · {{item.itemType}}</view></view><text class="amount">¥{{item.amount}}</text></view></view><view class="empty" wx:else>该时间段暂无记录</view><button class="float" bindtap="add">＋</button></view><view class="tabs"><view class="tab" bindtap="home"><text class="tab-icon">⌂</text>首页</view><view class="tab active"><text class="tab-icon">≡</text>记录</view><view class="tab" bindtap="stats"><text class="tab-icon">⌁</text>统计</view><view class="tab" bindtap="mine"><text class="tab-icon">○</text>我的</view></view>
