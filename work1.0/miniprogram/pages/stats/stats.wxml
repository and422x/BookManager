<view class="page"><view class="card"><view class="row"><picker mode="date" fields="month" value="{{startMonth}}" bindchange="setStart"><view class="date">{{startMonth||'开始月份'}}</view></picker><text class="muted">至</text><picker mode="date" fields="month" value="{{endMonth}}" bindchange="setEnd"><view class="date">{{endMonth||'结束月份'}}</view></picker></view></view><view class="summary"><text>所选区间消费</text><view>¥{{total}}</view></view><view class="card chart-card"><view class="chart-title">月度消费趋势</view><canvas wx:if="{{months.length}}" class="trend" canvas-id="trend"></canvas><view class="empty" wx:else>暂无可统计的数据</view></view><view class="muted tip">折线展示各月消费金额变化，可选择月份查看指定区间。</view></view><view class="tabs"><view class="tab" bindtap="home"><text class="tab-icon">⌂</text>首页</view><view class="tab" bindtap="records"><text class="tab-icon">≡</text>记录</view><view class="tab active"><text class="tab-icon">⌁</text>统计</view><view class="tab" bindtap="mine"><text class="tab-icon">○</text>我的</view></view>
